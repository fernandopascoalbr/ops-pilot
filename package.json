{
  "name": "incident-arena",
  "version": "1.0.0",
  "description": "IncidentArena reasoning engine with strategy comparison and bounded incident workflows",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "arena": "tsx --env-file=.env src/arena.ts",
    "reflect:plan-and-execute": "tsx --env-file=.env src/arena.ts --strategies reflect-plan-and-execute",
    "seed": "tsx --env-file=.env scripts/seed-alerts.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/**/*.test.ts"
  },
  "keywords": [
    "ops",
    "incident",
    "agent",
    "reasoning",
    "langgraph"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.1",
    "@langchain/openai": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
