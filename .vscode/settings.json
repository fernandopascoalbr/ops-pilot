{
  "github.copilot.chat.agent.terminal.allowList": [
    "npm run",
    "npm run test",
    "npx tsc",
    "node",
    "git status",
    "git diff",
    "git add",
    "git commit"
  ],
  "github.copilot.chat.agent.terminal.denyList": [
    "rm -rf",
    "sudo",
    "git push --force",
    "cat .env",
    "less .env",
    "more .env"
  ]
}
